# Copy to .env.local and adjust. Everything here is optional in Phase 0.
# Never commit real values: .env* files are git-ignored (except this one).

# --- Public: inlined into the browser bundle, so never put secrets here ---

# Canonical URL, used for absolute links and link previews.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "off" loads images straight from AniList's CDN instead of the /img proxy.
# NEXT_PUBLIC_IMAGE_PROXY=on

# Show the AniList debug panel outside development.
# NEXT_PUBLIC_DEBUG_PANEL=false

# --- Server only ---

# AniList GraphQL endpoint. End-to-end tests point this at a mock server.
# ANILIST_API_URL=https://graphql.anilist.co

# Starting request budget per minute. AniList allows 30/min while degraded.
# ANILIST_REQUESTS_PER_MINUTE=25

# Ceiling when AniList's headers report a higher limit (normally 90/min).
# ANILIST_MAX_REQUESTS_PER_MINUTE=76

# Timeout for one AniList request.
# ANILIST_TIMEOUT_MS=10000
