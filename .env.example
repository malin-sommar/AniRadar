# Copy to .env.local and adjust. Everything here is optional in Phase 0.
# Never commit real values: .env* files are git-ignored (except this one).

# --- Public: inlined into the browser bundle, so never put secrets here ---

# Canonical URL, used for absolute links and link previews.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "off" loads images straight from AniList's CDN instead of the /img proxy.
# NEXT_PUBLIC_IMAGE_PROXY=on

# Show the AniList debug panel outside development.
# NEXT_PUBLIC_DEBUG_PANEL=false

# --- Server only ---

# AniList GraphQL endpoint. End-to-end tests point this at a mock server.
# ANILIST_API_URL=https://graphql.anilist.co

# Starting request budget per minute. AniList allows 30/min while degraded.
# ANILIST_REQUESTS_PER_MINUTE=25

# Ceiling when AniList's headers report a higher limit (normally 90/min).
# ANILIST_MAX_REQUESTS_PER_MINUTE=76

# Timeout for one AniList request.
# ANILIST_TIMEOUT_MS=10000

# Jikan (unofficial MyAnimeList API), for MAL scores on detail pages.
# End-to-end tests point this at the mock server.
# JIKAN_API_URL=https://api.jikan.moe/v4

# Timeout for one Jikan request; the score is left out after it.
# JIKAN_TIMEOUT_MS=4000

# Kitsu API, used to match partial words in searches. End-to-end tests point
# this at the mock server.
# KITSU_API_URL=https://kitsu.io/api/edge

# Timeout for one Kitsu request; search falls back to AniList alone after it.
# KITSU_TIMEOUT_MS=3000

# --- Accounts (Phase 3). Without these, the app runs without sign-in. ---

# Supabase project (Project Settings → Data API / API keys). Read by the
# server only: the browser never talks to Supabase directly.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Bypasses row-level security. Server only; never commit it.
# SUPABASE_SECRET_KEY=sb_secret_...

# AniList API client (anilist.co/settings/developer). The redirect URL must
# match the client's exactly.
# ANILIST_CLIENT_ID=12345
# ANILIST_CLIENT_SECRET=...
# ANILIST_REDIRECT_URI=http://localhost:3000/auth/anilist/callback

# Encrypts AniList tokens at rest: 32 random bytes in base64. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ANILIST_TOKEN_KEY=
