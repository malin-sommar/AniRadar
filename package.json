    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:live": "vitest run --project live",
    "codegen": "graphql-codegen --config codegen.ts",
    "schema:fetch": "node scripts/fetch-anilist-schema.mjs",
    "fixtures:record": "node scripts/record-anilist-fixtures.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs"
  },
  "dependencies": {
    "@serwist/turbopack": "9.5.13",
    "@tanstack/query-async-storage-persister": "5.105.2",
