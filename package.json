    "@tanstack/react-query-persist-client": "5.105.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "nuqs": "2.10.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "serwist": "9.5.13",
